DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dm_chat
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
BACKEND_PORT=8000
# Django Channels WebSockets are served by the same ASGI server/port as the API.
SOCKET_PORT=8000
# Use "inmemory" for this local machine task. Redis is optional for a
# multi-worker deployment: CHANNEL_LAYER_BACKEND=redis
CHANNEL_LAYER_BACKEND=inmemory
REDIS_URL=redis://127.0.0.1:6379/0
